                <Image HorizontalAlignment="Right" Height="68" Margin="0,97,76,0" Grid.Row="2" VerticalAlignment="Top" Width="118" Source="/Images/Panel.png" Stretch="Fill" RenderTransformOrigin="0.5,0.5">
