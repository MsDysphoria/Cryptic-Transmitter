                    <GradientStop Color="#FF07247D" Offset="0"/>
                    <GradientStop Color="#FF262F5F" Offset="0.75"/>
                    <GradientStop Color="#FF3378AD" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

